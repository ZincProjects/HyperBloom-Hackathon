# Copy to backend/.env and fill in.

# Required for live Claude conversations. Without it MIRAGE runs an offline mock LLM.
ANTHROPIC_API_KEY=

# Omit for local SQLite (backend/mirage.db). Postgres example:
# DATABASE_URL=postgresql://mirage:mirage@localhost:5432/mirage
DATABASE_URL=

# Optional tuning
# MIRAGE_LLM_MODE=auto              # auto | live | mock
# MIRAGE_CHAT_MODEL=claude-opus-5
# MIRAGE_EXTRACTION_MODEL=claude-opus-5
# MIRAGE_CHAT_EFFORT=low
# MIRAGE_EXTRACTION_EFFORT=medium
# MIRAGE_REFUSAL_FALLBACKS=1
# MIRAGE_EMBEDDINGS=auto            # auto (fastembed ONNX MiniLM) | hashing
# MIRAGE_MODEL_CACHE=               # model download dir, default backend/.model_cache
# MIRAGE_SIMILARITY_THRESHOLD=0.85
# MIRAGE_CORS_ORIGINS=*
